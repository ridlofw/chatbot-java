<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="admin-panel"
      spacing="15" prefWidth="800" prefHeight="600"
      stylesheets="@styles/dark-theme.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- === Title === -->
    <Label text="⚙️ Manajemen FAQ" styleClass="admin-title"/>

    <!-- === FAQ Table === -->
    <TableView fx:id="faqTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colQuestion" text="Pertanyaan" prefWidth="250"/>
            <TableColumn fx:id="colAnswer" text="Jawaban" prefWidth="300"/>
            <TableColumn fx:id="colKeywords" text="Keywords" prefWidth="150"/>
        </columns>
        <placeholder>
            <Label text="Belum ada data FAQ. Tambahkan FAQ baru di bawah."/>
        </placeholder>
    </TableView>

    <!-- === Separator === -->
    <Separator/>

    <!-- === Form Area === -->
    <GridPane styleClass="admin-form" hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Row 0: Pertanyaan -->
        <Label text="Pertanyaan:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="faqQuestionField" promptText="Masukkan pertanyaan FAQ..."
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Row 1: Jawaban -->
        <Label text="Jawaban:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="faqAnswerField" promptText="Masukkan jawaban FAQ..."
                  prefRowCount="3" wrapText="true"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Row 2: Keywords -->
        <Label text="Keywords:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <VBox GridPane.rowIndex="2" GridPane.columnIndex="1" spacing="2">
            <TextField fx:id="faqKeywordsField" promptText="keyword1, keyword2, keyword3"/>
            <Label text="Pisahkan dengan koma" styleClass="hint-label"/>
        </VBox>
    </GridPane>

    <!-- === Action Buttons === -->
    <HBox styleClass="admin-buttons" spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addFaqButton" text="➕ Tambah" styleClass="btn-success"/>
        <Button fx:id="editFaqButton" text="✏️ Edit" styleClass="btn-edit"/>
        <Button fx:id="deleteFaqButton" text="🗑️ Hapus" styleClass="btn-danger"/>
        <Button fx:id="closeFaqButton" text="✖ Tutup" styleClass="btn-close"/>
    </HBox>

</VBox>
